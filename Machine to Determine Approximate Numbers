//Machine to Determine Approximate Numbers


#include<stdio.h>
void main(){ float a,b,c;
			scanf("%f %f",&a,&b);
			c=b-a;
			if(c<=0.5 && 0<=c)
				printf("Approximate number\n");
			else
				printf("Not an Approximate number\n");
}

