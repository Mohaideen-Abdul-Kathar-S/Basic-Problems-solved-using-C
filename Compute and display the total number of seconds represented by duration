//Compute and display the total number of seconds represented by duration


#include<stdio.h>
void main(){
	int a,b,c,d;
	scanf("%d",&a) && scanf("%d",&b) && scanf("%d",&c) && scanf("%d",&d);
	printf("%d seconds\n",d+c*60+b*60*60+a*24*60*60);
}


