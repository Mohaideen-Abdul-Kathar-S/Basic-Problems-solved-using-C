//Calculating the Area of the Top Triangle

#include<stdio.h>
#include<math.h>
void main(){
	float a,b,c,d,e;
	scanf("%f",&a) && scanf("%f",&b) && scanf("%f",&c);
	d=(a+b+c)/2;
	e=d*(d-a)*(d-b)*(d-c);
	printf("%0.2f",sqrt(e));
}

