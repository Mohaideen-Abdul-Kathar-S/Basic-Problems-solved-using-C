//Write a C program to perform temperature conversions from Centigrade to Fahrenheit and vice versa.


#include<stdio.h>
void main()
{ int a; float b,c,d;
	printf("Temperature Conversion:\n1.Celsius to Fahrenheit\n2.Fahrenheit to Celsius\n");
	printf("choice: ") && scanf("%d",&a);
	if(a==1)
	{
	printf("Enter Temperature in Celsius: ") && scanf("%f",&b);
	printf("Fahrenheit Temperature: %.2f\n",d=(b*9/5)+32);
	}
	else if(a==2)
	{
	printf("Enter Temperature in Fahrenheit: ") && scanf("%f",&c);
	printf("Celsius Temperature: %.2f\n",d=(c-32)*5/9);
	}
	else
	 printf("Invalid choice\n");
	
}

