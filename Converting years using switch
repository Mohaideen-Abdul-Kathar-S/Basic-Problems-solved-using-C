//Write a program to convert years into seconds, minutes, hours, days and months using a switch statement


#include<stdio.h>
int main()
{ int year,o;
printf("Enter number of years:") && scanf ("%d",&year);
printf("1.seconds\n2.minutes\n3.hours\n4.days\n5.months\n");
printf("Select an option:") && scanf("%d",&o);
switch(o){
	case 1:
		printf("Years to seconds:%d\n",365*24*60*60*year);
		break;
	case 2:
		printf("Years to minutes:%d\n",365*24*60*year);
		break;
	case 3:
		printf("Years to hours:%d\n",365*24*year);
		break;
	case 4:
		printf("Years to days:%d\n",365*year);
		break;
	case 5:
		printf("Years to months:%d\n",12*year);
		break;
	default:
		printf("Invalid choice\n");
}
 return 0;
}


