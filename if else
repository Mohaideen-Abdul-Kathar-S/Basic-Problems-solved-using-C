//Write a C program to check whether a given input integer is in between two values x and y.


#include<stdio.h>
void main() { int a,b,c;
	printf("lower bound(x): ") && scanf("%d",&a);
	printf("upper bound(y): ") && scanf("%d",&b);
	printf("number to check: ") && scanf("%d",&c);
	if(a<=c && c<=b)
	printf("%d is in between %d and %d\n",c,a,b);
	else 
	printf("%d is not in between %d and %d\n",c,a,b);
}


